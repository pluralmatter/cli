{
  "name": "pluralmatter",
  "version": "0.1.0",
  "description": "Talk to an evolving Plural Matter mind from your terminal.",
  "type": "module",
  "bin": {
    "pluralmatter": "bin/pluralmatter.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
