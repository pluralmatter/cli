  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pluralmatter/cli.git"
  },
  "homepage": "https://pluralmatter.com",
  "bugs": {
    "url": "https://github.com/pluralmatter/cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
